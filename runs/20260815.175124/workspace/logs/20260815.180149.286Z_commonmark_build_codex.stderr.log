def remove_indent(line: str, columns: int) -> str:
    structural = expand_indentation(line)
    remaining = structural[columns:] if len(structural) >= columns else ""
    consumed = len(line) - len(line.lstrip(" \t"))
    if consumed == 0:
        return line
    source_prefix = line[:consumed]
    if len(structural) <= columns:
        return ""
    # Structural prefixes are only needed for decisions; once removed,
    # retain the original suffix so tabs inside content remain literal.
    source_column = 0
    source_index = 0
    while source_index < len(source_prefix) and source_column < columns:
        source_column += 1 if source_prefix[source_index] == " " else 4 - (source_column % 4)
        source_index += 1
    return line[source_index:]
