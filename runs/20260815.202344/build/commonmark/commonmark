                        result.append(hold('<a href="'+html.escape(url,quote=True)+'">'+escape_text(value)+'</a>')); i=auto.end(); continue
                    if re.match(r'^[A-Za-z0-9.!#$%&\'*+/=?^_`{|}~-]+@[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*$',value):
                        result.append(hold('<a href="mailto:'+html.escape(value,quote=True)+'">'+escape_text(value)+'</a>')); i=auto.end(); continue
                tag_end=html_construct(text,i)
                if tag_end is not None:
                    result.append(hold(text[i:tag_end])); i=tag_end; continue
            result.append(text[i]); i+=1
        text=''.join(result)
        text=re.sub(r'\\\r?\n',lambda _:hold('<br />\n'),text)
        text=re.sub(r' {2,}\r?\n',lambda _:hold('<br />\n'),text)
        text=re.sub(r'\n[ \t]+','\n',text)
        text=re.sub(r'(\x00\d+\x00)[ \t]+', lambda m: m.group(1) if stash[int(m.group(1)[1:-1])].startswith('<br />') else m.group(0), text)
        text=re.sub(r'\\('+escapable[1:]+r')',lambda m:hold(escape_text(m.group(1))),text)
        text=escape_text(text)
        # Keep protected entities and escaped punctuation opaque to the
        # link/emphasis passes, then restore every protected token once.
        # images and links, including reference forms
        def unprotect(value):
            return re.sub(r'\x00(\d+)\x00', lambda m: '"' if stash[int(m.group(1))] == '\x01' else re.sub(r'<[^>]*>','',stash[int(m.group(1))]), value)
        def image(m):
            alt= re.sub(r'[*_`]','',m.group(1)); dest=unprotect(m.group(2)); title=unprotect(m.group(3)) if m.group(3) is not None else None
