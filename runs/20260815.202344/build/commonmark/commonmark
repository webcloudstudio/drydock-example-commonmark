            rawkey=(m.group(3) or m.group(2)).strip()
            rawkey=re.sub(r'\x00(\d+)\x00', lambda x: stash[int(x.group(1))], rawkey)
            key=rawkey.casefold()
            if key not in self.refs: return m.group(0)
            url,title=self.refs[key]
            url=quote(html.unescape(url), safe="/%:@?&=+$,;#-_.!~*'()")
            if m.group(1):
                return '<img src="'+html.escape(url,quote=True)+'" alt="'+html.escape(m.group(2),quote=True)+'"'+((' title="'+html.escape(html.unescape(title),quote=True)+'"') if title else '')+' />'
            return '<a href="'+html.escape(url,quote=True)+'"'+((' title="'+html.escape(html.unescape(title),quote=True)+'"') if title else '')+'>'+self.inline(m.group(2))+'</a>'
        # Reference syntax was resolved by extract_links before escaping.
        text=self._process_emphasis(text)
        text=re.sub(r' {2,}\n','<br />\n',text)
        for _ in range(len(stash) + 1):
            for i,v in enumerate(stash): text=text.replace(f'\x00{i}\x00',v)
        text=text.replace('\x01','&quot;')
        return text

    @staticmethod
    def _is_unicode_punctuation(ch):
        return bool(ch) and unicodedata.category(ch)[0] in ('P', 'S')

    @classmethod
    def _delimiter_flanking(cls, text, start, end):
        before = text[start - 1] if start else '\n'
        after = text[end] if end < len(text) else '\n'
