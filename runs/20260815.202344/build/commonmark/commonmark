    @staticmethod
    def valid_html_tag_line(value):
        value=value.rstrip(' \t')
        m=re.match(r'</?([A-Za-z][A-Za-z0-9-]*)', value)
        if not m or not value.endswith('>'): return False
        body=value[m.end():-1]
        if value.startswith('</'):
            return bool(re.fullmatch(r'[ \t\r\n]*', body))
        if body.endswith('/'):
            body=body[:-1].rstrip(' \t\r\n')
        attr=re.compile(r'[ \t\r\n]+([A-Za-z_:][A-Za-z0-9_.:-]*)(?:[ \t\r\n]*=[ \t\r\n]*(?:[^ \t\r\n"\'=<>`]+|"[^"]*"|\'[^\']*\'))?')
        pos=0
        while pos < len(body):
            match=attr.match(body,pos)
            if not match: return body[pos:].strip(' \t\r\n') == ''
            pos=match.end()
