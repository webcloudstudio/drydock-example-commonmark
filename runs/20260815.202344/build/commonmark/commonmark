                                    'count':opener['count']-use,'original':opener['original'],
                                    'open':opener['open'],'close':opener['close']})
            replacement.append(wrapped)
            if closer['count'] > use:
                replacement.append({'kind':'delim','marker':closer['marker'],
                                    'count':closer['count']-use,'original':closer['original'],
                                    'open':closer['open'],'close':closer['close']})
            tokens[opener_index:closer_index+1]=replacement
