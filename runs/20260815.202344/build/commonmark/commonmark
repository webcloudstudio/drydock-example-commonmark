            a='<img src="'+html.escape(dest,quote=True)+'" alt="'+html.escape(alt,quote=True)+'"'
            if title is not None: a+=' title="'+html.escape(title,quote=True)+'"'
            return a+' />'
        def link(m):
            label=m.group(1); dest=quote(unprotect(m.group(2)), safe="/%:@?&=+$,;#-_.!~*'()"); title=unprotect(m.group(3)) if m.group(3) is not None else None
            a='<a href="'+html.escape(dest,quote=True)+'"'
            if title is not None: a+=' title="'+html.escape(title,quote=True)+'"'
            return a+'>'+self.inline(label)+'</a>'
        destination=r'(?:\x00\d+\x00|[^ \t\n)])+?'
        def inline_link(match):
            body=unprotect(match.group(2)).strip(); title=None
            if '&quot;' in body or '&amp;quot;' in body:
                return match.group(0)
            title_match=re.match(r'^(.*?)[ \t]+(?:"([^"]*)"|\'([^\']*)\'|\(([^)]*)\))$',body)
            if title_match: body=title_match.group(1); title=title_match.group(2) or title_match.group(3) or title_match.group(4)
            if body.startswith('<') and body.endswith('>'): body=body[1:-1]
            fake=type('M',(),{'group':lambda _,n: [None,match.group(1),body,title][n]})()
            return link(fake)
        def inline_image(match):
            body=unprotect(match.group(2)).strip(); title=None
            title_match=re.match(r'^(.*?)[ \t]+(?:"([^"]*)"|\'([^\']*)\'|\(([^)]*)\))$',body)
            if title_match: body=title_match.group(1); title=title_match.group(2) or title_match.group(3) or title_match.group(4)
            if body.startswith('<') and body.endswith('>'): body=body[1:-1]
            fake=type('M',(),{'group':lambda _,n: [None,match.group(1),body,title][n]})()
            return image(fake)
        # Link/image syntax was resolved by extract_links before escaping.
        def ref(m):
            key=(m.group(2) or m.group(1)).strip().casefold(); r=self.refs.get(key)
            if not r:return m.group(0)
            if m.group(0).startswith('!'):
                return '<img src="'+html.escape(r[0],quote=True)+'" alt="'+html.escape(m.group(1),quote=True)+'"'+((' title="'+html.escape(r[1],quote=True)+'"') if r[1] else '')+' />'
            return '<a href="'+html.escape(r[0],quote=True)+'"'+((' title="'+html.escape(r[1],quote=True)+'"') if r[1] else '')+'>'+self.inline(m.group(1))+'</a>'
