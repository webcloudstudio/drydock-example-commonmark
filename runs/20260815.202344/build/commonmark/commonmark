#!/usr/bin/env python3
import html
import re
import sys
import unicodedata
from urllib.parse import quote

ESCAPABLE = r'!"#$%&\'()*+,-./:;<=>?@[\\]^_`{|}~'
INLINE_TAGS = re.compile(r'<(?:[A-Za-z][A-Za-z0-9+.-]{1,31}:[^ >]+|[A-Za-z][^ >]*@[^ >]+|/?[A-Za-z][^>]*|!--[\s\S]*?--|\?[\s\S]*?\?|![A-Z]+\s+[\s\S]*?\s*!|![CDATA\[[\s\S]*?\]\])>')

def esc_text(s):
    return html.escape(s, quote=False)

def normalize_source(s):
    s = s.replace('\r\n', '\n').replace('\r', '\n').replace('\x00', '\ufffd')
    # Expand tabs only while measuring leading indentation; preserve interior tabs.
    expanded=[]
    for line in s.splitlines():
        col=0; result=''; leading=True
        structural_prefix = re.match(r'^ {0,3}(?:>|[-+*]|\d{1,9}[.)])', line) is not None
        for ch in line:
            if ch=='\t':
                if leading or structural_prefix:
                    spaces=4-(col%4)
                    result+=' '*spaces; col+=spaces
                else:
                    result+='\t'; col+=1
            else:
                result+=ch; col+=1
                if ch!=' ': leading=False
        expanded.append(result)
    return '\n'.join(expanded) + ('\n' if not s.endswith('\n') else '')

class Document:
    def __init__(self, source):
        self.lines = normalize_source(source).splitlines()
        self.refs = {}

    def parse(self):
        self.collect_refs()
        return self.blocks(self.lines)

    def collect_refs(self):
        # Resolve standalone definitions, including their permitted continuation lines.
        staged=[]; kept=[]; j=0
        while j < len(self.lines):
            first=self.lines[j]
            if re.match(r' {0,3}\[[^\]]*$', first):
                k = j + 1
                while k < len(self.lines) and self.lines[k].strip() and ']: ' not in self.lines[k] and not re.search(r'\]:[ \t]', self.lines[k]): k += 1
                if k < len(self.lines) and re.search(r'\]:[ \t]', self.lines[k]):
                    first = first + '\n' + '\n'.join(self.lines[j + 1:k + 1])
                    self.lines[j] = first
                    del self.lines[j + 1:k + 1]
            mm=re.match(r' {0,3}\[((?:\\.|[^\]])+)\]:[ \t]*(.*)$', first)
            if mm and not first.startswith('    ') and (j == 0 or not self.lines[j-1].strip() or re.match(r' {0,3}#{1,6}[ \t]', self.lines[j-1]) or self.is_thematic(self.lines[j-1])):
                label, rest=mm.group(1), mm.group(2); k=j+1
                while k < len(self.lines) and k < j+100 and self.lines[k].strip() and (not rest.strip() or self.parse_reference(rest) is None or (self.parse_reference(rest)[1] is None and self.lines[k].lstrip().startswith(("'", '"', '(')))):
                    rest += '\n' + self.lines[k]; k += 1
                parsed=self.parse_reference(rest)
                if parsed is not None:
                    key=self.ref_key(label)
                    if label.strip() and not re.search(r'(?<!\\)\[', label):
                        if key not in self.refs: self.refs[key]=parsed
                        j=k; continue
            kept.append(first); j+=1
        self.lines=kept
        out=[]; i=0; protected=False; boundary=True; previous_ref=False
        while i < len(self.lines):
            line=self.lines[i]
            fence=re.match(r' {0,3}(`{3,}|~{3,})', line)
            if fence:
                protected=not protected
                out.append(line); i+=1; boundary=False; previous_ref=False; continue
            quoted_reference=False
            if line.startswith('>'):
                probe=re.sub(r'^ {0,3}>[ \t]?','',line)
                if re.match(r'\[[^\]]+\]:',probe): line=probe; quoted_reference=True
                else:
                    out.append(line); i+=1; boundary=False; previous_ref=False; continue
            if protected or line.startswith('    '):
                out.append(line); i+=1; boundary=False; previous_ref=False; continue
            candidate=[line]; end=i+1
            # Labels may span lines, but only through the first closing bracket.
            can_ref=boundary or previous_ref or (i > 0 and (re.match(r' {0,3}#{1,6}[ \t]', self.lines[i-1]) or self.is_thematic(self.lines[i-1])))
            if not can_ref or not re.match(r' {0,3}\[((?:\\.|[^\]])*)\]:', line):
                if re.match(r' {0,3}\[$', line):
                    while end < len(self.lines) and end-i < 1000:
                        candidate.append(self.lines[end]);
                        if ']' in self.lines[end]: end += 1; break
                        end += 1
                else:
                    out.append(line); i+=1; boundary=not bool(line.strip()); previous_ref=False; continue
            text='\n'.join(candidate)
            m=re.match(r' {0,3}\[((?:\\.|[^\]])+)\]:[ \t]*(.*)$', text, re.S)
            if not m:
                out.append(line); i+=1; boundary=not bool(line.strip()); previous_ref=False; continue
            label=m.group(1); rest=m.group(2)
            # Destination and title may use one following line each.
            while end < len(self.lines) and (not self.parse_reference(rest) or rest.strip()=='' or (self.parse_reference(rest)[1] is None and re.match(r'^[ \t]+[\'"(]', self.lines[end]))):
                if not self.lines[end].strip(): break
                if not (rest.rstrip().endswith((':', '<', "'", '"', '(')) or re.match(r'^[ \t]+[\'"(]', self.lines[end])): break
                rest += '\n' + self.lines[end]; end += 1
            parsed=self.parse_reference(rest)
            if parsed is None:
                out.extend(self.lines[i:end] if end > i+1 else [self.lines[i]]); i=end; boundary=False; previous_ref=False; continue
            key=self.ref_key(label)
            if not label.strip() or re.search(r'(?<!\\)\[', label):
                out.extend(self.lines[i:end] if end > i + 1 else [self.lines[i]])
                i = end; boundary = False; previous_ref = False; continue
            if key not in self.refs: self.refs[key]=parsed
            if quoted_reference: out.append('>')
            i=end; boundary=False; previous_ref=True; continue
        self.lines=out

    @staticmethod
    def ref_key(label):
        return re.sub(r'[ \t\n]+',' ',label.strip()).casefold()

    @staticmethod
    def parse_reference(rest):
        rest=rest.strip(' \t\n')
        if rest.startswith('<'):
            close=rest.find('>')
            if close < 0 or '\n' in rest[1:close]: return None
            dest=rest[1:close]; tail=rest[close+1:]
            if tail and tail[0] not in ' \t\n': return None
            if tail and tail[0] not in ' \t\n': return None
        else:
            dest=''; tail=''
            # Consume balanced parentheses in ordinary destinations.
            depth=0; pos=0; stopped=False
            while pos < len(rest):
                ch=rest[pos]
                if ch=='\\': pos += 2; continue
                if ch=='(': depth+=1
                elif ch==')':
                    if depth==0: break
                    depth-=1
                if ch in ' \t\n' and depth==0:
                    break
                pos += 1
            dest=rest[:pos]
            tail=rest[pos:]
        tail=tail.strip(' \t\n')
        title=None
        if tail:
            q=tail[0]
            endchar={"'":"'", '"':'"', '(' : ')'}.get(q)
            if not endchar: return None
            escaped=False; end=None
            for j in range(1,len(tail)):
                if escaped: escaped=False; continue
                if tail[j]=='\\': escaped=True; continue
                if tail[j]==endchar: end=j; break
            if end is None or tail[end+1:].strip(' \t\n'): return None
            title=tail[1:end]
        if not dest and rest != '<>': return None
        dest=re.sub(r'\\([!"#$%&\'()*+,\-./:;<=>?@[\\\]^_`{|}~])',r'\1',dest)
        title=None if title is None else re.sub(r'\\([!"#$%&\'()*+,\-./:;<=>?@[\\\]^_`{|}~])',r'\1',title)
        return dest,title

    def inline(self, text):
