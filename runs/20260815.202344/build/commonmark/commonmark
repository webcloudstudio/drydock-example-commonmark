    def _paragraph_fallback(self, lines, out, start):
        b=[lines[start]]; i=start+1
        while i<len(lines) and lines[i].strip(): b.append(lines[i]); i+=1
        out.append('<p>'+self.inline('\n'.join(b))+'</p>')
        return '\n'.join(out)+'\n'

    @staticmethod
