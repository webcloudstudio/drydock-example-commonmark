    @staticmethod
    def is_thematic(line):
        if len(line)-len(line.lstrip(' '))>3: return False
        s=line.strip(' \t'); chars=s.replace(' ','').replace('\t','')
        return len(chars)>=3 and chars[0] in '*-_' and len(set(chars))==1

    @staticmethod
    def html_block_kind(line):
        s=line.lstrip(' ') if len(line)-len(line.lstrip(' '))<=3 else ''
        low=s.lower()
        if not s: return None
        for tag in ('pre','script','style','textarea'):
            if re.match(r'<'+tag+r'(?:[ \t>]|$)',low): return tag
        if low.startswith('<!--'): return 'comment'
        if low.startswith('<?'): return 'pi'
        if re.match(r'<![a-z]',low): return 'decl'
        if low.startswith('<![cdata['): return 'cdata'
        block=r'(?:address|article|aside|base|basefont|blockquote|body|caption|center|col|colgroup|dd|details|dialog|dir|div|dl|dt|fieldset|figcaption|figure|footer|form|frame|frameset|h[1-6]|head|header|hr|html|iframe|legend|li|link|main|menu|nav|ol|p|param|section|summary|table|tbody|td|tfoot|th|thead|title|tr|track|ul)'
        if re.match(r'</?'+block+r'(?:[ \t/>]|$)',low): return 'block'
