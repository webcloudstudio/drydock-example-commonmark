            ref = re.compile(r'&(?:#[0-9]{1,7}|#[xX][0-9A-Fa-f]{1,6}|[A-Za-z][A-Za-z0-9]{1,31});')
            result=[]; pos=0
            def plain(part):
                return html.escape(part, quote=True)
            for m in ref.finditer(value):
                result.append(plain(value[pos:m.start()]))
                token=m.group(0)
                if token.startswith('&#'):
                    try:
                        num=int(token[3:-1],16) if token[2].lower()=='x' else int(token[2:-1])
                        value2='\ufffd' if num == 0 or num > 0x10ffff or 0xd800 <= num <= 0xdfff else chr(num)
                    except (ValueError, OverflowError): value2=token
                else: value2=html.entities.html5.get(token[1:-1]+';', token)
                result.append(hold(html.escape(value2, quote=True))); pos=m.end()
            result.append(plain(value[pos:]))
            return ''.join(result)

        def link_unescape(value):
            return re.sub(r'\\([!"#$%&\'()*+,\-./:;<=>?@\[\\\]^_`{|}~])', r'\1', html.unescape(value))

        def bracket_end(value, opening):
            depth = 0; escaped = False
            for j in range(opening + 1, len(value)):
                ch = value[j]
                if escaped: escaped = False; continue
                if ch == '\\': escaped = True
                elif ch == '[': depth += 1
                elif ch == ']':
                    if depth == 0: return j
                    depth -= 1
            return None

        def title_at(value, start):
            if start >= len(value) or value[start] not in "\"'(": return None
            closing = {'"':'"', "'":"'", '(' : ')'}[value[start]]
            escaped = False
            for j in range(start + 1, len(value)):
                ch = value[j]
                if escaped: escaped = False
                elif ch == '\\': escaped = True
                elif ch == closing: return value[start + 1:j], j + 1
            return None

        def tail_at(value, start):
            if start >= len(value) or value[start] != '(': return None
            j = start + 1
            while j < len(value) and value[j] in ' \t\n': j += 1
            if j < len(value) and value[j] == '<':
                k = j + 1; escaped = False
                while k < len(value):
                    if value[k] in '\r\n': return None
