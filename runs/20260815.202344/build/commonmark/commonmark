                    elif value[k] == '\\': escaped = True
                    elif value[k] == '>': break
                    k += 1
                if k >= len(value) or escaped: return None
                dest = value[j + 1:k]; j = k + 1
            else:
                begin = j; depth = 0; escaped = False
                while j < len(value):
                    ch = value[j]
                    if escaped: escaped = False; j += 1; continue
                    if ch == '\\': escaped = True; j += 1; continue
                    if ch in ' \t\n' and depth == 0: break
                    if ch == '(': depth += 1
                    elif ch == ')':
                        if depth == 0: break
                        depth -= 1
                    j += 1
                if depth: return None
                dest = value[begin:j]
                if any(c in ' \t\n\r' for c in dest): return None
            while j < len(value) and value[j] in ' \t\n': j += 1
            title = None
            if j < len(value) and value[j] != ')':
                parsed = title_at(value, j)
                if parsed is None: return None
                title, j = parsed
                while j < len(value) and value[j] in ' \t\n': j += 1
            if j >= len(value) or value[j] != ')': return None
            return dest, title, j + 1

        def render_link(label, dest, title, image):
            url = quote(link_unescape(dest), safe="/%:@?&=+$,;#-_.!~*'()")
            if image:
                rendered_alt = self.inline(label)
                rendered_alt = re.sub(r'<img\b[^>]*\balt="([^"]*)"[^>]*/>', r'\1', rendered_alt)
                alt = html.unescape(re.sub(r'<[^>]*>', '', rendered_alt))
                out = '<img src="' + html.escape(url, quote=True) + '" alt="' + html.escape(alt, quote=True) + '"'
            else:
                out = '<a href="' + html.escape(url, quote=True) + '"'
            if title is not None: out += ' title="' + html.escape(link_unescape(title), quote=True) + '"'
            return out + (' />' if image else '>' + self.inline(label) + '</a>')

        def extract_links(value):
            out=[]; i=0
            while i < len(value):
                image = value.startswith('![', i); opening = i + 1 if image else i
                if value.rfind('<', 0, i) > value.rfind('>', 0, i) or value[:i].count('`') % 2:
                    out.append(value[i]); i += 1; continue
                if value[opening:opening + 1] != '[' or (i and value[i - 1] == '\\'):
                    out.append(value[i]); i += 1; continue
                close = bracket_end(value, opening)
                if close is None: out.append(value[i]); i += 1; continue
                parsed = tail_at(value, close + 1) if close + 1 < len(value) and value[close + 1] == '(' else None
                if parsed:
                    inner = value[opening + 1:close]
                    if not image and (re.search(r'(?<!\!)\[[^\n]*\](?:\s*\(|\s*\[)', inner) or inner.count('`') % 2 or ('<' in inner and '>' not in inner)):
                        out.append(value[i]); i += 1; continue
                    out.append(hold(render_link(inner, parsed[0], parsed[1], image))); i = parsed[2]; continue
                ref_end = close + 1; ref_label = value[opening + 1:close]
                if ref_end < len(value) and value[ref_end] == '[':
                    end = value.find(']', ref_end + 1)
                    if end < 0: end = ref_end
                    else:
                        supplied = value[ref_end + 1:end]
                        if re.search(r'(?<!\\)\[|(?<!\\)\]', supplied):
                            out.append(value[i:ref_end + 1]); i = ref_end + 1; continue
                        ref_label = supplied or ref_label; ref_end = end + 1
                if not ref_label.strip():
                    out.append(value[i:ref_end]); i = ref_end; continue
                key = self.ref_key(ref_label)
                if key in self.refs:
                    dest, title = self.refs[key]
                    inner = value[opening + 1:close]
                    if not image and (re.search(r'(?<!\!)\[[^\n]*\](?:\s*\(|\s*\[)', inner) or inner.count('`') % 2 or ('<' in inner and '>' not in inner)):
                        out.append(value[i]); i += 1; continue
                    out.append(hold(render_link(value[opening + 1:close], dest, title, image))); i = ref_end; continue
                out.append(value[i]); i += 1
            return ''.join(out)

        text = extract_links(text)

        # Protect code spans, autolinks, and valid raw HTML before escaping.
        def html_construct(value, start):
            """Return the end of one valid raw HTML construct, if present."""
            tail=value[start:]
            if tail.startswith('<!--'):
                if tail.startswith('<!-->') or tail.startswith('<!--->'):
                    return start + (5 if tail.startswith('<!-->') else 6)
                end=tail.find('-->', 4)
                return start + end + 3 if end >= 0 else None
            if tail.startswith('<?'):
                end=tail.find('?>', 2)
                return start + end + 2 if end >= 0 else None
            if tail.startswith('<![CDATA['):
                end=tail.find(']]>', 9)
                return start + end + 3 if end >= 0 else None
            if re.match(r'<![A-Za-z]', tail):
                end=tail.find('>', 2)
                return start + end + 1 if end >= 0 else None
            m=re.match(r'</?([A-Za-z][A-Za-z0-9-]*)', tail)
            if not m: return None
            pos=m.end(); closing=tail.startswith('</')
            if closing:
                while pos < len(tail) and tail[pos] in ' \t\r\n': pos += 1
                return start + pos + 1 if pos < len(tail) and tail[pos] == '>' else None
